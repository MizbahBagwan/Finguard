const canvas = document.getElementById("aiCoreCanvas");

if(!canvas){
    console.log("Canvas not found");
}


const scene = new THREE.Scene();


const camera = new THREE.PerspectiveCamera(
    45,
    canvas.clientWidth / canvas.clientHeight,
    0.1,
    1000
);


const renderer = new THREE.WebGLRenderer({
    canvas:canvas,
    alpha:true,
    antialias:true
});


renderer.setSize(
    canvas.clientWidth,
    canvas.clientHeight
);


camera.position.z = 4;



// AI CORE

const geometry =
new THREE.IcosahedronGeometry(1,2);


const material =
new THREE.MeshBasicMaterial({

    color:0x00ffff,
    wireframe:true

});


const core =
new THREE.Mesh(
    geometry,
    material
);


scene.add(core);



// animation

function animate(){

    requestAnimationFrame(animate);

    core.rotation.y += 0.01;
    core.rotation.x += 0.005;


    renderer.render(
        scene,
        camera
    );

}


animate();
const canvas =
document.getElementById(
"aiCoreCanvas"
);


const scene =
new THREE.Scene();


const camera =
new THREE.PerspectiveCamera(
45,
canvas.clientWidth /
canvas.clientHeight,
0.1,
1000
);


const renderer =
new THREE.WebGLRenderer({

    canvas,
    alpha:true,
    antialias:true

});


renderer.setSize(
canvas.clientWidth,
canvas.clientHeight
);



camera.position.z=5;



// CORE SPHERE

const geometry =
new THREE.IcosahedronGeometry(
1,
2
);



const material =
new THREE.MeshBasicMaterial({

    color:0x00eaff,

    wireframe:true

});


const sphere =
new THREE.Mesh(
geometry,
material
);


scene.add(sphere);



// ROTATING RINGS

for(let i=0;i<3;i++){

const ring =
new THREE.Mesh(

new THREE.TorusGeometry(
1.4+i*.25,
0.015,
16,
100
),

new THREE.MeshBasicMaterial({

color:0x00ffff

})

);


ring.rotation.x=Math.PI/2;

scene.add(ring);

}



// PARTICLES

const particles =
new THREE.BufferGeometry();


let positions=[];


for(
let i=0;i<800;i++
){

positions.push(
(Math.random()-0.5)*10,
(Math.random()-0.5)*5,
(Math.random()-0.5)*5
);

}


particles.setAttribute(

"position",

new THREE.Float32BufferAttribute(
positions,
3
)

);


const stars =
new THREE.Points(

particles,

new THREE.PointsMaterial({

color:0x00ccff,

size:.02

})

);


scene.add(stars);




// ANIMATION

function animate(){

requestAnimationFrame(
animate
);


sphere.rotation.y+=0.008;

stars.rotation.y+=0.001;


renderer.render(
scene,
camera
);

}


animate();